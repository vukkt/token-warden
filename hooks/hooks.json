{
	"hooks": {
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "cd \"${CLAUDE_PLUGIN_ROOT}\" && { [ -f node_modules/.warden-deps-ok ] || { npm ci --no-audit --no-fund --silent && touch node_modules/.warden-deps-ok; }; } && ./node_modules/.bin/tsx src/collect.ts || true",
						"timeout": 120
					}
				]
			}
		],
		"SubagentStop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "cd \"${CLAUDE_PLUGIN_ROOT}\" && [ -f node_modules/.warden-deps-ok ] && ./node_modules/.bin/tsx src/collect.ts || true",
						"timeout": 30
					}
				]
			}
		],
		"SessionStart": [
			{
				"matcher": "startup|resume",
				"hooks": [
					{
						"type": "command",
						"command": "cd \"${CLAUDE_PLUGIN_ROOT}\" && [ -f node_modules/.warden-deps-ok ] && ./node_modules/.bin/tsx src/notify.ts || true",
						"timeout": 10
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "SendMessage",
				"hooks": [
					{
						"type": "command",
						"command": "cd \"${CLAUDE_PLUGIN_ROOT}\" && [ -f node_modules/.warden-deps-ok ] && ./node_modules/.bin/tsx src/gate.ts || true",
						"timeout": 10
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "SendMessage",
				"hooks": [
					{
						"type": "command",
						"command": "cd \"${CLAUDE_PLUGIN_ROOT}\" && [ -f node_modules/.warden-deps-ok ] && ./node_modules/.bin/tsx src/gate.ts --post || true",
						"timeout": 10
					}
				]
			}
		]
	}
}
