{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"entry": [
		"src/select.ts",
		"src/collect.ts",
		"src/notify.ts",
		"src/distill.ts",
		"src/receipt.ts",
		"src/power.ts",
		"src/cost.ts",
		"scripts/*.mjs",
		"validation/calibration.ts",
		"validation/dress-rehearsal.ts",
		"validation/empirical-calibration.ts",
		"validation/full-loop-experiment.ts",
		"validation/naive-headroom-experiment.ts",
		"validation/selftest.ts",
		"validation/stream-calibration.ts",
